{
  "name": "teams-generator",
  "version": "1.3.0",
  "private": true,
  "description": "Generate teams randomly based on rank. This is useful if you want to create lineups of balanced teams.",
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "clean": "nuxt cleanup && rm -rf node_modules .generated .nuxt",
    "dev": "nuxt dev",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "run-s nuxt:prepare db:generate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "pnpm docker:up && playwright test && pnpm docker:down",
    "test:ui": "pnpm docker:up && playwright test --ui && pnpm docker:down",
    "test:dev": "pnpm docker:up && pnpm test:db:reset && nuxt dev --dotenv .env.test",
    "test:db:reset": "dotenv -e .env.test -- zen migrate reset --force",
    "test:build": "nuxt build --dotenv .env.test",
    "test:preview": "nuxt preview --dotenv .env.test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "nuxt:prepare": "nuxt prepare",
    "nuxt:build": "nuxt build",
    "db:deploy": "zen migrate deploy",
    "db:generate": "zen generate --lite",
    "db:migrate": "zen migrate dev",
    "playwright": "playwright",
    "dotenv": "dotenv"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.123",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.1.0",
    "@pinia/colada-devtools": "1.1.2",
    "@pinia/nuxt": "1.0.2",
    "@playwright/test": "1.62.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/core": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "@zenstackhq/cli": "3.9.1",
    "dotenv-cli": "11.0.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "npm-run-all2": "9.0.3",
    "nuxt": "4.5.2",
    "pinia": "4.0.3",
    "sharp": "0.35.3",
    "sharp-ico": "0.1.5",
    "std-env": "4.2.0",
    "vue-tsc": "3.3.10"
  },
  "dependencies": {
    "@formwerk/core": "0.14.4",
    "@nuxt/ui": "4.10.0",
    "@pinia/colada": "1.4.2",
    "@pinia/colada-nuxt": "1.0.2",
    "@vueuse/components": "14.4.0",
    "@vueuse/router": "14.4.0",
    "@zenstackhq/orm": "3.9.1",
    "@zenstackhq/plugin-policy": "3.9.1",
    "@zenstackhq/server": "3.9.1",
    "lodash-es": "4.18.1",
    "nuxt-ui-formwerk": "0.2.0",
    "pg": "8.23.0",
    "pg-connection-string": "2.14.0",
    "typescript": "6.0.3",
    "vue-slicksort": "2.0.5",
    "zenstack-pinia-colada": "0.2.8",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3"
    }
  }
}
